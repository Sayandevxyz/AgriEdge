# AgriEdge Environment Configuration

# Application Mode: development / production
APP_MODE=development

# Database Configuration (PostgreSQL / SQLite fallback)
# For local dev without Postgres: sqlite:///./agriedge.db
# For production: postgresql://user:password@localhost:5432/agriedge
DATABASE_URL=sqlite:///./agriedge.db

# Redis Cache & Queue (optional in local dev mode, memory fallback used if unreachable)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=agriedge_jwt_super_secret_key_change_in_production_987654321
JWT_REFRESH_SECRET=agriedge_jwt_refresh_super_secret_key_change_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# External AI Providers (Optional - local fallback used if not provided)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=

# Weather Service (OpenWeatherMap API Key)
# If empty, high-accuracy agricultural meteorological fallback is used and badged as "Local development fallback"
WEATHER_API_KEY=

# Market Intelligence Service
# If empty, displays "Live market data unavailable" without fake live claims
MARKET_API_KEY=

# S3 / Object Storage (Optional - local filesystem storage used in development)
STORAGE_ENDPOINT=
STORAGE_BUCKET=agriedge-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Speech Services
STT_PROVIDER=browser_native
TTS_PROVIDER=browser_native

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
